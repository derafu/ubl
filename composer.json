{
    "name": "derafu/ubl",
    "description": "Derafu: UBL - One Language for Every Business Document",
    "type": "library",
    "homepage": "https://www.derafu.dev/docs/data/ubl",
    "license": "MIT",
    "authors": [
        {
            "name": "Esteban De La Fuente Rubio / Derafu",
            "homepage": "https://www.derafu.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/derafu/ubl/issues",
        "source": "https://github.com/derafu/ubl"
    },
    "autoload": {
        "psr-4": {
            "Derafu\\Ubl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Derafu\\TestsUbl\\": "tests/src/"
        }
    },
    "require": {
        "php": "^8.5",
        "derafu/translation": "dev-main",
        "xterr/php-ubl": "1.2.0"
    },
    "require-dev": {
        "ext-curl": "*",
        "ext-xdebug": "*",
        "ext-zip": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.4",
        "nikic/php-parser": "^5.9",
        "symfony/yaml": "^8.1",
        "xterr/php-ubl-generator": "^1.4",
        "opis/json-schema": "^2.6",
        "symfony/dependency-injection": "^8.1",
        "symfony/config": "^8.1"
    },
    "scripts": {
        "docs": "php tools/phpdocumentor run --config=phpdoc.xml",
        "tests": "XDEBUG_MODE=coverage vendor/bin/phpunit --configuration=phpunit.xml",
        "phpcs-fix": "vendor/bin/php-cs-fixer fix -v --config=php-cs-fixer.php",
        "phpcs": "vendor/bin/php-cs-fixer fix -v --dry-run --diff --config=php-cs-fixer.php",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "phpstan-export": "vendor/bin/phpstan analyse --configuration=phpstan.neon --level 9 --generate-baseline",
        "generate-oasis": "php tools/generate-oasis.php && php tools/patch-oasis.php && composer phpcs-fix",
        "fetch-oasis-examples": "php tools/fetch-oasis-examples.php",
        "fetch-oasis-json": "php tools/fetch-oasis-json.php",
        "post-install-cmd": "php tools/patch-xterr-ubl.php",
        "post-update-cmd": "php tools/patch-xterr-ubl.php"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "opis/json-schema": "Required to validate JSON and YAML documents against the official OASIS JSON schemas.",
        "nikic/php-parser": "Required by the tests of the messages of the package (Derafu\\Translation\\Lint reads the code)."
    }
}
